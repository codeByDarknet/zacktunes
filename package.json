{
  "name": "zacktunes",
  "version": "1.0.0",
  "description": "Gestionnaire de musiques YouTube - Streaming et téléchargement",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "fetch-binaries": "node download-ytdlp.js",
    "build": "node download-ytdlp.js && electron-builder",
    "build:linux": "node download-ytdlp.js && electron-builder --linux",
    "build:win": "node download-ytdlp.js && electron-builder --win",
    "build:mac": "node download-ytdlp.js && electron-builder --mac"
  },
  "keywords": [
    "youtube",
    "music",
    "player",
    "electron"
  ],
  "author": {
    "name": "Abdoul Razack Ouedraogo",
    "email": "abdoulrazackouedraogo1@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.1.0",
    "axios": "^1.6.0",
    "fluent-ffmpeg": "^2.1.2",
    "sanitize-filename": "^1.6.3"
  },
  "homepage": "https://codebydarknet.github.io/zacktunes/",
  "repository": {
    "type": "git",
    "url": "https://github.com/codeByDarknet/zacktunes.git"
  }
}
