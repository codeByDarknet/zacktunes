{
  "name": "tunespocket",
  "version": "1.0.0",
  "description": "Gestionnaire de musiques YouTube - Streaming et téléchargement",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "prebuild": "node download-ytdlp.js",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64",
    "build:linux": "electron-builder --linux deb"
  },
  "keywords": [
    "youtube",
    "music",
    "player",
    "electron"
  ],
  "author": {
    "name": "Abdoul Razack Ouedraogo",
    "email": "abdoulrazackouedraogo1@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.1.0",
    "axios": "^1.6.0",
    "fluent-ffmpeg": "^2.1.2",
    "sanitize-filename": "^1.6.3"
  },
  "build": {
    "appId": "com.tunespocket.app",
    "productName": "TunesPocket",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!resources/**",
      "!dist/**",
      "!node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!node_modules/*.d.ts",
      "!node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}",
      "!build/**",
      "!mvp.md",
      "!TEST.md",
      "!download-ytdlp.js"
    ],
    "asarUnpack": [
      "node_modules/@fortawesome/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/default-cover1.ico",
      "extraResources": [
        {
          "from": "resources/yt-dlp.exe",
          "to": "yt-dlp.exe"
        },
        {
          "from": "resources/ffmpeg.exe",
          "to": "ffmpeg.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TunesPocket"
    },
    "linux": {
      "target": [
        "deb"
      ],
      "icon": "build/icons",
      "category": "AudioVideo",
      "executableName": "tunespocket",
      "synopsis": "Gestionnaire de musiques YouTube",
      "extraResources": [
        {
          "from": "resources/yt-dlp",
          "to": "yt-dlp"
        }
      ],
      "desktop": {
        "Name": "TunesPocket",
        "GenericName": "Lecteur de musique",
        "Categories": "AudioVideo;Audio;Player;",
        "Keywords": "musique;youtube;mp3;audio;",
        "StartupWMClass": "TunesPocket"
      }
    },
    "deb": {
      "depends": [
        "ffmpeg",
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    }
  },
  "homepage": "https://github.com/codeByDarknet/tunespocket"
}
